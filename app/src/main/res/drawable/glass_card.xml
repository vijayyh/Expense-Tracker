<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: see-through white with a bright thin border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="28dp" />
    <gradient
        android:angle="315"
        android:endColor="@color/glass_fill"
        android:startColor="@color/glass_fill_strong" />
    <stroke
        android:width="1dp"
        android:color="@color/glass_stroke" />
</shape>
