<?xml version="1.0" encoding="utf-8"?>
<!-- Main balance card: colourful gradient with a glassy shine on top -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="32dp" />
            <gradient
                android:angle="315"
                android:endColor="@color/primary_2"
                android:startColor="@color/primary" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="32dp" />
            <gradient
                android:angle="270"
                android:centerColor="#0DFFFFFF"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF" />
            <stroke
                android:width="1.5dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
